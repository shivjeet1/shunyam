import { LineEdit, Button, ScrollView, ProgressIndicator, ComboBox } from "std-widgets.slint";

export struct Device {
    id: string,
    model: string,
    capacity: string,
    status: string,
    progress: float,
    // phase: "idle" | "wiping" | "verifying" | "done"
    phase: string,
    job_id: string,
    dev_class: string,
    is_system: bool,
}

export component MainWindow inherits Window {
    title: "Shunya Secure Wipe";
    preferred-width: 940px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 560px;
    background: #121212;
    default-font-family: "Inter, sans-serif";

    in property <[Device]> devices: [];
    in property <bool> daemon_connected: false;

    // UI State: "setup" | "ready" | "active"
    in-out property <string> ui_state: "setup";
    in-out property <string> daemon_status_msg: "";
    in-out property <bool>   daemon_starting: false;

    in-out property <int>    selected_device_index: -1;
    in-out property <string> active_challenge: "";
    property  <string>       challenge_input: "";
    in-out property <string> selected_method: "NIST 800-88 Cryptographic Erase (Crypto Erase)";

    // Cert panel state
    in-out property <bool>   cert_generating: false;
    in-out property <string> cert_status_msg: "";
    property  <string>       operator_id: "";

    // Verify cert panel state
    in-out property <string> verify_status: "idle"; // idle, verifying, success, error
    in-out property <string> verify_manifest_json: "";
    in-out property <string> verify_error_message: "";

    callback start_daemon();
    callback request_challenge(string);
    callback start_wipe(string, string, string);  // (device_id, challenge, method)
    callback generate_cert(string, string);       // (job_id, operator_id)
    callback refresh_drives();
    callback verify_certificate(string);          // (device_id)

    // ─── Root layout ──────────────────────────────────────────────────────────
    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        // Header bar
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "Shunya Secure Wipe";
                    font-size: 24px; font-weight: 800; color: #ffffff;
                }
                Text {
                    text: "Enterprise Storage Sanitization & Cryptographic Destruction";
                    font-size: 11px; color: #777777;
                }
            }
            HorizontalLayout {
                spacing: 12px; alignment: end;
                Rectangle {
                    width: 10px; height: 10px; border-radius: 5px;
                    background: root.daemon_connected ? #4CAF50 : #F44336;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.daemon_connected ? "Daemon Online (127.0.0.1:9090)" : "Daemon Offline";
                    color: root.daemon_connected ? #4CAF50 : #F44336;
                    font-size: 12px; font-weight: 600; vertical-alignment: center;
                }
            }
        }

        // ── STATE: SETUP ────────────────────────────────────────────────────
        if root.ui_state == "setup" : Rectangle {
            background: #1e1e1e;
            border-radius: 8px;
            border-width: 1px;
            border-color: #333333;
            VerticalLayout {
                alignment: center; spacing: 16px;
                padding: 40px;
                
                Text {
                    text: "Privileged Daemon Offline";
                    color: #ffffff; font-size: 20px; font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Shunya requires a background service running as root to safely\naccess raw block devices and issue cryptographic wipe commands.";
                    color: #999999; font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                
                if root.daemon_status_msg != "" : Text {
                    text: root.daemon_status_msg;
                    color: #e2b340; font-size: 13px;
                    horizontal-alignment: center;
                }
                
                HorizontalLayout {
                    alignment: center;
                    padding-top: 16px;
                    Button {
                        text: root.daemon_starting ? "Starting..." : "Start Daemon (Requires Sudo)";
                        enabled: !root.daemon_starting;
                        primary: true; height: 36px; width: 240px;
                        clicked => {
                            root.daemon_starting = true;
                            root.daemon_status_msg = "Requesting root privileges via polkit...";
                            root.start_daemon();
                        }
                    }
                }
            }
        }

        // ── STATE: READY ─────────────────────────────────────────────────────
        if root.ui_state == "ready" : HorizontalLayout {
            spacing: 24px;
            alignment: center;
            
            // Left Card: Sanitization Console
            Rectangle {
                horizontal-stretch: 1;
                max-width: 420px;
                background: #16221c;
                border-radius: 8px;
                border-width: 1px;
                border-color: #274031;
                VerticalLayout {
                    alignment: center; spacing: 16px;
                    padding: 40px;
                    
                    Text {
                        text: "Sanitization Console";
                        color: #4ade80; font-size: 20px; font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Access the main dashboard to cryptographically wipe\ndrives and generate compliance certificates.";
                        color: #a3a3a3; font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 16px;
                        Button {
                            text: "Start Wipe Console";
                            primary: true; height: 36px; width: 220px;
                            clicked => { root.ui_state = "active"; }
                        }
                    }
                }
            }

            // Right Card: Certificate Auditor
            Rectangle {
                horizontal-stretch: 1;
                max-width: 420px;
                background: #1c2233;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2d3752;
                VerticalLayout {
                    alignment: center; spacing: 16px;
                    padding: 40px;
                    
                    Text {
                        text: "Certificate Auditor";
                        color: #60a5fa; font-size: 20px; font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Verify tamperproof compliance certificates directly\nstored on previously wiped storage media.";
                        color: #a3a3a3; font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 16px;
                        Button {
                            text: "Audit & Verify Drive";
                            primary: true; height: 36px; width: 220px;
                            clicked => { root.ui_state = "verify"; }
                        }
                    }
                }
            }
        }

        // ── STATE: VERIFY ────────────────────────────────────────────────────
        if root.ui_state == "verify" : HorizontalLayout {
            spacing: 20px;

            // ── Left pane: device list ───────────────────────────────────────
            Rectangle {
                horizontal-stretch: 38;
                min-width: 250px;
                background: #1a1a1a; border-radius: 12px;
                border-width: 1px; border-color: #2a2a2a;

                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Select Drive to Audit";
                            color: #ffffff; font-size: 16px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "⟳ Refresh";
                            clicked => { root.refresh_drives(); }
                        }
                    }
                    if root.devices.length == 0 : Text {
                        text: "No storage devices detected.";
                        color: #555555; font-size: 13px;
                    }
                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;
                            for device[i] in root.devices : Rectangle {
                                height: 60px;
                                background: i == root.selected_device_index ? #1a3050 : #222222;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: i == root.selected_device_index ? #3a7ab7 : transparent;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: device.id; color: #ffffff; font-size: 13px; font-weight: 700; }
                                        Text { text: device.capacity + " • " + device.model; color: #aaaaaa; font-size: 11px; }
                                    }
                                }
                                TouchArea {
                                    clicked => { 
                                        root.selected_device_index = i; 
                                        root.verify_status = "idle";
                                    }
                                }
                            }
                        }
                    }
                    Button {
                        text: "← Back to Main Menu";
                        clicked => { root.ui_state = "ready"; }
                    }
                }
            }

            // ── Right pane: Verification context ────────────────────────────
            Rectangle {
                horizontal-stretch: 62;
                min-width: 400px;
                background: #1a1a1a; border-radius: 12px;
                border-width: 1px; border-color: #2a2a2a;
                VerticalLayout {
                    padding: 30px; spacing: 20px;
                    if root.selected_device_index == -1 : VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Select a drive from the list\nto extract and verify its compliance certificate.";
                            color: #777777; font-size: 14px; horizontal-alignment: center;
                        }
                    }
                    if root.selected_device_index != -1 : VerticalLayout {
                        spacing: 20px;
                        Text {
                            text: "Certificate Verification";
                            color: #ffffff; font-size: 18px; font-weight: 700;
                        }
                        Text {
                            text: "Shunya automatically provisions a read-only partition (FAT32/ISO9660) at the end of the wiped block device containing the tamperproof, cryptographically signed JSON & PDF certificates. Verification ensures the signature on the disk exactly matches the physical token public keys.";
                            color: #aaaaaa; font-size: 13px;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            background: #111111; border-radius: 6px; border-width: 1px; border-color: #333333;
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                Text { text: "Target Device: " + root.devices[root.selected_device_index].id; color: #ffffff; font-weight: 600; font-size: 14px; }
                                Text { text: "Device Model: " + root.devices[root.selected_device_index].model; color: #aaaaaa; font-size: 13px; }
                            }
                        }
                        if root.verify_status == "idle" || root.verify_status == "error" : Button {
                            text: "Extract & Verify Cryptographic Signature";
                            primary: true; height: 40px;
                            clicked => { 
                                root.verify_status = "verifying";
                                root.verify_certificate(root.devices[root.selected_device_index].id); 
                            }
                        }
                        if root.verify_status == "verifying" : Text {
                            text: "Extracting from partition and verifying PIV signature...";
                            color: #ffcc00; font-size: 14px; font-weight: 600; horizontal-alignment: center;
                        }
                        if root.verify_status == "success" : Rectangle {
                            background: #102a1b; border-radius: 6px; border-width: 1px; border-color: #274031;
                            VerticalLayout {
                                padding: 16px; spacing: 8px;
                                Text { text: "✅ Certificate VERIFIED successfully!"; color: #4ade80; font-weight: 700; font-size: 14px; }
                                Text { text: "Manifest Signature is authentic."; color: #a3a3a3; font-size: 13px; }
                                Text { text: root.verify_manifest_json; color: #a3a3a3; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        if root.verify_status == "error" : Rectangle {
                            background: #331515; border-radius: 6px; border-width: 1px; border-color: #4a1f1f;
                            VerticalLayout {
                                padding: 16px; spacing: 8px;
                                Text { text: "❌ Verification FAILED"; color: #ef4444; font-weight: 700; font-size: 14px; }
                                Text { text: root.verify_error_message; color: #ffb3b3; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }

        // ── STATE: ACTIVE ─────────────────────────────────────────────────────
        if root.ui_state == "active" : HorizontalLayout {
            spacing: 20px;

            // ── Left pane: device list ───────────────────────────────────────
            Rectangle {
                horizontal-stretch: 38;
                min-width: 250px;
                background: #1a1a1a; border-radius: 12px;
                border-width: 1px; border-color: #2a2a2a;

                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Connected Storage Media";
                            color: #ffffff; font-size: 16px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "⟳ Refresh";
                            clicked => { root.refresh_drives(); }
                        }
                    }
                    if root.devices.length == 0 : Text {
                        text: "No storage devices detected.";
                        color: #555555; font-size: 13px;
                    }
                    ScrollView {
                        VerticalLayout {
                            spacing: 8px;
                            for device[i] in root.devices : Rectangle {
                                height: 76px;
                                background: i == root.selected_device_index ? #1a3050 : #222222;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: i == root.selected_device_index ? #3a7ab7 : transparent;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                                    Rectangle {
                                        width: 38px; height: 38px; background: #2d2d2d; border-radius: 6px;
                                        y: (parent.height - self.height) / 2;
                                        Text {
                                            text: device.phase == "done" ? "✅"
                                                : device.phase == "wiping" || device.phase == "verifying" ? "⚙️"
                                                : device.dev_class == "nvme-ssd" ? "⚡"
                                                : "💾";
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            font-size: 18px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: device.model;
                                                color: #eeeeee; font-weight: 600; font-size: 13px;
                                                overflow: elide;
                                            }
                                            if device.dev_class == "nvme-ssd" : Rectangle {
                                                background: #00332c; border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    padding-top: 1px; padding-bottom: 1px;
                                                    Text { text: "NVMe"; color: #00bfa5; font-size: 9px; font-weight: 700; }
                                                }
                                            }
                                            if device.dev_class == "usb-hdd" : Rectangle {
                                                background: #25123d; border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    padding-top: 1px; padding-bottom: 1px;
                                                    Text { text: "USB"; color: #b388ff; font-size: 9px; font-weight: 700; }
                                                }
                                            }
                                            if device.is_system : Rectangle {
                                                background: #3e1010; border-radius: 3px;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    padding-top: 1px; padding-bottom: 1px;
                                                    Text { text: "OS"; color: #ff5252; font-size: 9px; font-weight: 700; }
                                                }
                                            }
                                        }
                                        Text {
                                            text: device.id + "  •  " + device.capacity;
                                            color: #888888; font-size: 11px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "Status: " + device.status;
                                            color: device.phase == "done" ? #4CAF50
                                                 : device.phase == "wiping" || device.phase == "verifying" ? #ff9800
                                                 : #666666;
                                            font-size: 10px;
                                        }
                                    }
                                    // Status dot
                                    Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px;
                                        y: (parent.height - self.height) / 2;
                                        background: device.phase == "done" ? #4CAF50
                                                  : device.phase == "wiping" || device.phase == "verifying" ? #ff9800
                                                  : #555555;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.selected_device_index = i;
                                        root.active_challenge = "";
                                        root.challenge_input = "";
                                        root.cert_status_msg = "";
                                    }
                                }
                            }
                        }
                    }
                    Button {
                        text: "← Back to Main Menu";
                        clicked => { root.ui_state = "ready"; }
                    }
                }
            }

            // ── Right pane: detail / control ─────────────────────────────────
            Rectangle {
                horizontal-stretch: 62;
                min-width: 400px;
                background: #1a1a1a; border-radius: 12px;
                border-width: 1px; border-color: #2a2a2a;

                // No device selected
                if root.selected_device_index < 0 || root.selected_device_index >= root.devices.length : VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "← Select a storage drive to configure sanitization";
                        color: #666666; horizontal-alignment: center; font-size: 15px;
                    }
                    Text {
                        text: "Supports NVMe Cryptographic Erase, Quick Format (TRIM), NIST Purge/Clear, and DoD 5220.22-M";
                        color: #444444; horizontal-alignment: center; font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                // Device selected
                if root.selected_device_index >= 0 && root.selected_device_index < root.devices.length : ScrollView {
                    VerticalLayout {
                        padding-left: 24px; padding-right: 24px;
                        padding-top: 20px;  padding-bottom: 20px;
                        spacing: 16px;

                        // ── Device info card ───────────────────────────────
                        Rectangle {
                            background: #232323; border-radius: 8px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: root.devices[root.selected_device_index].model;
                                            color: #ffffff; font-size: 16px; font-weight: 700;
                                        }
                                        Rectangle {
                                            background: root.devices[root.selected_device_index].dev_class == "nvme-ssd" ? #004d40
                                                      : root.devices[root.selected_device_index].dev_class == "usb-hdd" ? #311b92
                                                      : #37474f;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: root.devices[root.selected_device_index].dev_class == "nvme-ssd" ? #00bfa5
                                                        : root.devices[root.selected_device_index].dev_class == "usb-hdd" ? #7c4dff
                                                        : #78909c;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                padding-top: 2px; padding-bottom: 2px;
                                                Text {
                                                    text: root.devices[root.selected_device_index].dev_class == "nvme-ssd" ? "NVMe SSD (Crypto Capable)"
                                                        : root.devices[root.selected_device_index].dev_class == "usb-hdd" ? "USB Storage"
                                                        : "SATA / Block";
                                                    color: #ffffff; font-size: 10px; font-weight: 600;
                                                }
                                            }
                                        }
                                        if root.devices[root.selected_device_index].is_system : Rectangle {
                                            background: #b71c1c; border-radius: 4px;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                padding-top: 2px; padding-bottom: 2px;
                                                Text {
                                                    text: "ACTIVE OS DRIVE";
                                                    color: #ffffff; font-size: 10px; font-weight: 700;
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: "Block Node: " + root.devices[root.selected_device_index].id
                                        + "   |   Capacity: " + root.devices[root.selected_device_index].capacity;
                                    color: #888888; font-size: 12px;
                                }
                            }
                        }

                        // ── System Disk Warning Banner ────────────────────
                        if root.devices[root.selected_device_index].is_system && root.devices[root.selected_device_index].phase == "idle" : Rectangle {
                            background: #330b0b;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #d32f2f;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "⚠️"; font-size: 14px; }
                                    Text {
                                        text: "SYSTEM DRIVE PROTECTION ACTIVE";
                                        color: #ff5252; font-weight: 700; font-size: 12px;
                                    }
                                }
                                Text {
                                    text: "This drive contains active root or boot partitions. Shunya's Policy Gate strictly rejects destructive commands on mounted system volumes.";
                                    color: #ffcdd2; font-size: 11px; wrap: word-wrap;
                                }
                            }
                        }

                        // ── Wipe method selector (only before wipe starts) ─
                        if root.devices[root.selected_device_index].phase == "idle" : VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                Text { text: "Sanitization Method & Standard:"; color: #aaaaaa; font-size: 13px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                if root.devices[root.selected_device_index].dev_class == "nvme-ssd" : Rectangle {
                                    background: #00332c;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #00bfa5;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px;
                                        padding-top: 2px; padding-bottom: 2px;
                                        Text { text: "⚡ NVMe Crypto Sanitize Available"; color: #00bfa5; font-size: 10px; font-weight: 700; }
                                    }
                                }
                            }
                            ComboBox {
                                model: [
                                    "NIST 800-88 Cryptographic Erase (Crypto Erase)",
                                    "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)",
                                    "NIST 800-88 Purge (ChaCha20 O_DIRECT)",
                                    "NIST 800-88 Clear (Single Pass Zero)",
                                    "DoD 5220.22-M (3-Pass Overwrite)"
                                ];
                                current-value <=> root.selected_method;
                            }

                            // Dynamic explanation card for the selected method
                            Rectangle {
                                background: #16202c;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #273e5a;
                                VerticalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    padding-top: 10px; padding-bottom: 10px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        Text {
                                            text: root.selected_method == "NIST 800-88 Cryptographic Erase (Crypto Erase)" ? "⚡ Cryptographic Erase (Instant Hardware Sanitization)"
                                                : root.selected_method == "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)" ? "⚡ Quick Format (Fast Block Discard & Table Zeroing)"
                                                : root.selected_method == "NIST 800-88 Purge (ChaCha20 O_DIRECT)" ? "🔒 NIST Purge (Cryptographic PRNG Overwrite)"
                                                : root.selected_method == "NIST 800-88 Clear (Single Pass Zero)" ? "🧹 NIST Clear (Single-Pass Zero Fill)"
                                                : "🛡️ DoD 5220.22-M (3-Pass Overwrite & Verify)";
                                            color: #80c0ff;
                                            font-weight: 700;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: root.selected_method == "NIST 800-88 Cryptographic Erase (Crypto Erase)" ? "Est. Time: < 5 sec"
                                                : root.selected_method == "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)" ? "Est. Time: < 10 sec"
                                                : root.selected_method == "NIST 800-88 Clear (Single Pass Zero)" ? "Est. Time: ~15 min / 100 GB"
                                                : root.selected_method == "NIST 800-88 Purge (ChaCha20 O_DIRECT)" ? "Est. Time: ~20 min / 100 GB"
                                                : "Est. Time: ~60 min / 100 GB";
                                            color: #ffcc00;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.selected_method == "NIST 800-88 Cryptographic Erase (Crypto Erase)" ? "Triggers controller-level NVMe/ATA SANITIZE / Crypto Scramble to destroy the Media Encryption Key (MEK). Renders all physical and spare blocks unreadable in seconds without wearing flash cells. Meets NIST SP 800-88 Rev. 1 Purge standard for encrypted media."
                                            : root.selected_method == "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)" ? "Sends BLKDISCARD / TRIM commands across all logical blocks to immediately unmap and deallocate flash memory, while explicitly zeroing partition headers (GPT/MBR) and filesystem structures for immediate reuse."
                                            : root.selected_method == "NIST 800-88 Purge (ChaCha20 O_DIRECT)" ? "Generates a cryptographically strong pseudorandom stream via ChaCha20, writing via direct unbuffered I/O (O_DIRECT | O_SYNC) across every user-accessible sector to permanently overwrite media."
                                            : root.selected_method == "NIST 800-88 Clear (Single Pass Zero)" ? "Overwrites all addressable storage blocks with binary zeroes (0x00) across the entire capacity to ensure logical data cannot be retrieved by standard read tools."
                                            : "3-pass military specification: Pass 1 writes zeroes (0x00), Pass 2 writes complementary ones (0xFF), Pass 3 writes a random pattern, followed by a read-verification pass.";
                                        color: #b0c4de;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // ── Progress bar (visible when phase != idle) ─
                        if root.devices[root.selected_device_index].phase != "idle" : VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                Text { text: root.devices[root.selected_device_index].status; color: #dddddd; font-size: 13px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: round(root.devices[root.selected_device_index].progress) + "%";
                                    color: #aaaaaa; font-size: 13px;
                                }
                            }
                            ProgressIndicator {
                                progress: root.devices[root.selected_device_index].progress / 100.0;
                                height: 10px;
                            }
                        }

                        // ── Carving audit panel (Verifying phase) ──────────
                        if root.devices[root.selected_device_index].phase == "verifying" : Rectangle {
                            background: #0d1f35; border-radius: 8px;
                            border-width: 1px; border-color: #1a4a80;
                            VerticalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 14px;  padding-bottom: 14px;
                                spacing: 8px;
                                Text {
                                    text: "🔍  Deep Carving Audit — shunya-carve";
                                    color: #80c0ff; font-weight: 700; font-size: 14px;
                                }
                                Text {
                                    text: "Validating sector sanitization: scanning for residual JPEG/PNG/PDF boundaries and checking cryptographic entropy...";
                                    color: #aaaacc; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        // ── Certificate panel (done phase) ──────────────────
                        if root.devices[root.selected_device_index].phase == "done" : Rectangle {
                            background: #0d250d; border-radius: 10px;
                            border-width: 1px; border-color: #4CAF50;
                            VerticalLayout {
                                padding-left: 20px; padding-right: 20px;
                                padding-top: 16px;  padding-bottom: 16px;
                                spacing: 12px;

                                Text {
                                    text: "✅  Sanitization Verified — Carving Score: 0 Anomalies";
                                    color: #4CAF50; font-size: 15px; font-weight: 700;
                                }
                                Text {
                                    text: "Completed via " + root.selected_method + "\nCryptographic verification passed. Compliance certificate can now be generated.";
                                    color: #aaaaaa; font-size: 12px; wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Operator ID:";
                                        color: #aaaaaa; font-size: 13px;
                                        vertical-alignment: center;
                                        width: 90px;
                                    }
                                    LineEdit {
                                        placeholder-text: "e.g. SEC-ADMIN-01";
                                        text <=> root.operator_id;
                                    }
                                }

                                Button {
                                    text: root.cert_generating
                                        ? "Signing via SmartCard (shunya-cert)…"
                                        : "🔏  Generate Compliance Certificate";
                                    primary: true;
                                    enabled: !root.cert_generating && root.operator_id != "";
                                    clicked => {
                                        root.cert_generating = true;
                                        root.generate_cert(
                                            root.devices[root.selected_device_index].job_id,
                                            root.operator_id
                                        );
                                    }
                                }
                                if root.cert_status_msg != "" : Text {
                                    text: root.cert_status_msg;
                                    color: #80d080; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }

                        // ── Auth / challenge section (idle phase only) ──────
                        if root.devices[root.selected_device_index].phase == "idle" : VerticalLayout {
                            spacing: 12px;

                            if root.active_challenge == "" : Button {
                                text: root.selected_method == "NIST 800-88 Cryptographic Erase (Crypto Erase)" ? "🔐  Authorize Cryptographic Erase"
                                    : root.selected_method == "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)" ? "⚡  Authorize Quick Format / Discard"
                                    : "🔐  Authorize Secure Wipe";
                                primary: true; height: 44px;
                                clicked => {
                                    root.request_challenge(root.devices[root.selected_device_index].id);
                                }
                            }

                            if root.active_challenge != "" : Rectangle {
                                background: #200808; border-radius: 10px;
                                border-width: 1px; border-color: #c62828;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px;
                                    padding-top: 16px;  padding-bottom: 16px;
                                    spacing: 12px;
                                    Text {
                                        text: "⚠  Physical Presence Challenge Required";
                                        color: #ff5252; font-size: 15px; font-weight: 700;
                                    }
                                    Text {
                                        text: "Type the one-time challenge code exactly to authorize execution:";
                                        color: #dddddd; font-size: 12px;
                                    }
                                    Text {
                                        text: root.active_challenge;
                                        color: #ffffff; font-size: 24px; font-weight: 900;
                                        horizontal-alignment: center;
                                    }
                                    LineEdit {
                                        placeholder-text: "Enter verification code…";
                                        text <=> root.challenge_input;
                                    }
                                    Button {
                                        text: root.selected_method == "NIST 800-88 Cryptographic Erase (Crypto Erase)" ? "⚡  EXECUTE CRYPTO ERASE"
                                            : root.selected_method == "Quick Format / Fast Block Discard (TRIM / BLKDISCARD)" ? "⚡  EXECUTE QUICK FORMAT"
                                            : "⚡  EXECUTE WIPE";
                                        primary: true;
                                        enabled: root.challenge_input == root.active_challenge;
                                        clicked => {
                                            root.start_wipe(
                                                root.devices[root.selected_device_index].id,
                                                root.challenge_input,
                                                root.selected_method
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
