import { LineEdit } from "std-widgets.slint";

export struct Device {
    id: string,
    model: string,
    capacity: string,
    status: string,
    progress: float,
}

export component MainWindow inherits Window {
    title: "Shunya Secure Wipe";
    width: 800px;
    height: 600px;
    background: #1e1e1e;

    in property <[Device]> devices: [
        { id: "/dev/nvme0n1", model: "Samsung 980 PRO", capacity: "1.0 TB", status: "Ready", progress: 0.0 }
    ];
    
    in-out property <int> selected_device_index: 0;
    in-out property <string> active_challenge: "";
    property <string> challenge_input: "";

    callback start_wipe(string, string);
    callback request_challenge(string);

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: "Shunya Secure Wipe";
            font-size: 24px;
            color: white;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 20px;
            
            // Left Pane: Disks Grid
            Rectangle {
                width: parent.width * 0.4;
                background: #2d2d2d;
                border-radius: 8px;
                
                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;
                    
                    Text {
                        text: "Available Devices";
                        color: #aaaaaa;
                        font-size: 16px;
                    }
                    
                    VerticalLayout {
                        for device[i] in root.devices : Rectangle {
                            height: 60px;
                            background: i == root.selected_device_index ? #3a3a3a : transparent;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding: 10px;
                                Text {
                                    text: device.id + " - " + device.model;
                                    color: white;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { 
                                    root.selected_device_index = i; 
                                    root.active_challenge = "";
                                    root.challenge_input = "";
                                }
                            }
                        }
                    }
                }
            }

            // Right Pane: Details & Wipe Control
            Rectangle {
                background: #2d2d2d;
                border-radius: 8px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 15px;

                    if root.devices.length > 0 : VerticalLayout {
                        spacing: 15px;
                        Text {
                            text: "Device Details";
                            color: #aaaaaa;
                            font-size: 16px;
                        }

                        Text {
                            text: "ID: " + root.devices[root.selected_device_index].id;
                            color: white;
                        }
                        Text {
                            text: "Model: " + root.devices[root.selected_device_index].model;
                            color: white;
                        }
                        Text {
                            text: "Capacity: " + root.devices[root.selected_device_index].capacity;
                            color: white;
                        }
                        Text {
                            text: "Status: " + root.devices[root.selected_device_index].status + " (" + round(root.devices[root.selected_device_index].progress) + "%)";
                            color: #4CAF50; // green-ish
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }
                        
                        if root.active_challenge == "" : Rectangle {
                            height: 40px;
                            background: #d32f2f;
                            border-radius: 8px;
                            Text {
                                text: "AUTHORIZE WIPE";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { 
                                    root.request_challenge(root.devices[root.selected_device_index].id); 
                                }
                            }
                        }

                        if root.active_challenge != "" : VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Physical Presence Challenge:";
                                color: #ffcc00;
                            }
                            Text {
                                text: "Type '" + root.active_challenge + "' to confirm wipe:";
                                color: white;
                            }
                            LineEdit {
                                placeholder-text: root.active_challenge;
                                text <=> root.challenge_input;
                            }
                            
                            Rectangle {
                                height: 50px;
                                background: #d32f2f; // Red for destructive action
                                border-radius: 8px;

                                Text {
                                    text: "START WIPE";
                                    color: white;
                                    font-size: 18px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { 
                                        root.start_wipe(root.devices[root.selected_device_index].id, root.challenge_input); 
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
